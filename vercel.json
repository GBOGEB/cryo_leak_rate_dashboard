{
  "buildCommand": "./build.sh",
  "outputDirectory": "docs",
  "rewrites": [
    { "source": "/", "destination": "/NAVIGATOR.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
